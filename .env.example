# Leave empty to use Vite's /api proxy during development.
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://127.0.0.1:5276

# OAuth client IDs are public identifiers. Never put client secrets in VITE_*.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Optional client-side map key, restricted to the intended application origins.
VITE_CARTO_API_KEY=
