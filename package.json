{
  "name": "parkjom-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "lint": "npm run typecheck",
    "build": "vite build",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "capacitor:sync:after": "node scripts/prepare-native.mjs",
    "deploy": "vite build && firebase deploy --only hosting",
    "typecheck": "tsc --noEmit",
    "test": "node tests/parking-coordinates.mjs && node tests/vehicle-storage.mjs && node tests/native-google-auth.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capgo/capacitor-social-login": "^8.4.5",
    "@gsap/react": "^2.1.2",
    "@microsoft/signalr": "^10.0.11",
    "@react-oauth/google": "^0.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.12",
    "puppeteer-core": "^25.16.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
